# Copy to .env for local non-docker runs (Node 24+ loads it with --env-file,
# e.g. `node --env-file=.env src/server.js`).

# Any Postgres-compliant database (RDS, Cloud SQL, Supabase, Neon, ...)
DATABASE_URL=postgres://bhagyacard:bhagyacard@localhost:5432/bhagyacard
# Set to "require" for managed providers that enforce TLS
#PGSSL=require

PORT=3000
#PG_POOL_MAX=10

# Product-day timezone + cutover hour. The Bhagya Card day (draws, streak,
# deck, countdown) rolls over at 06:00 IST by default.
#DAY_TZ=Asia/Kolkata
#DAY_START_HOUR=6

# Internal Coin API (system-transactions, HTTP Basic auth) — server-side
# only, never exposed to the client. Leave COIN_API_URL unset to use the
# built-in at-most-once stub ledger (coin_credit_attempts table).
# Dev endpoint: https://dev-api.astrolokal.com/v1/system-transactions/
#COIN_API_URL=https://dev-api.astrolokal.com/v1/system-transactions/
#COIN_API_USER=replace-me
#COIN_API_PASS=replace-me

# Gemini — nightly generation of the daily card deck (server-side only).
# Leave unset to use the sampleDeck from the experiment config; any Gemini
# failure falls back to yesterday's deck, then the samples — stale beats
# broken, the page never breaks.
#GEMINI_API_KEY=replace-me
#GEMINI_MODEL=gemini-2.5-flash

# How many hours before the 06:00 IST cutover tomorrow's deck is
# pre-generated ("each night"). 0 disables pre-generation (the deck is then
# published at the cutover itself). Default 4.
#DECK_PREGEN_HOURS=4

# Override the experiment config location (k8s mounts a ConfigMap here)
#EXPERIMENT_CONFIG_PATH=/etc/bhagya-card/experiment.config.json
