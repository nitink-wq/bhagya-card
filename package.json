{
  "name": "bhagya-card",
  "version": "0.1.0",
  "private": true,
  "description": "AstroLokal 'Bhagya Card' — daily fortune card + 7-day streak retention/conversion surface (webview client + server-authoritative backend)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create --migration-file-language cjs",
    "deck:generate": "node scripts/generate-daily-deck.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1"
  }
}
